VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Cloudinary (profile pictures). Cloud name + unsigned preset only, never the API secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Paystack (test mode). Public key only, from Paystack > Settings > API Keys. Never add the secret key here.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
VITE_PAYSTACK_CURRENCY=ZAR

# EmailJS (booking confirmation emails), from emailjs.com. All three are public IDs.
VITE_EMAILJS_SERVICE_ID=service_your_id
VITE_EMAILJS_TEMPLATE_ID=template_your_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_WELCOME_TEMPLATE_ID=template_your_welcome_id
# Where customers email enquiries (shown in emails)
VITE_SUPPORT_EMAIL=hello@example.com

# Set to true before launch: staff can only update a job on its day, and past jobs count as missed.
# Leave unset/false while testing so jobs can be completed any time.
VITE_STRICT_JOB_TIMING=false
