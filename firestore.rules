rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Helper Function: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. Helper Function: Check if the user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 3. Helper Function: Check if the user has an admin role
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 4. Rules for user profiles and their subcollections
    match /users/{userId} {
      // Users can read their own profile; admins can read all profiles to view customer contact info
      allow read: if isOwner(userId) || isAdmin();
      
      // Customers cannot set role to admin on signup; staff can activate their account
      allow create: if (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role in ['customer', 'staff'])) || isAdmin();
      
      // Users cannot elevate their own role to admin and cannot alter employeeId if it exists; admins can update profiles
      allow update: if (
        isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('employeeId' in request.resource.data) || !('employeeId' in resource.data) || request.resource.data.employeeId == resource.data.employeeId)
      ) || isAdmin();
      allow delete: if isAdmin();

      // Specific rule for appointments:
      // Customers cannot confirm their own bookings, cannot assign staff, and cannot alter terminal (cancelled/completed) bookings
      // Assigned staff can only access jobs assigned to them
      match /appointments/{appointmentId} {
        allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid);
        
        // Creation must start unconfirmed with no staff assigned
        allow create: if (isOwner(userId) && 
                         (!('confirmed' in request.resource.data) || request.resource.data.confirmed == false) &&
                         (!('assignedStaffUid' in request.resource.data) || request.resource.data.assignedStaffUid == null) &&
                         (!('status' in request.resource.data) || request.resource.data.status == 'Awaiting Confirmation'))
                      || isAdmin();
        
        // Customer updates cannot self-confirm, cannot assign staff, and cannot overwrite cancelled/completed appointments
        // Admin updates cannot modify cancelled or completed appointments
        // Assigned staff can update job status (e.g. mark completed)
        allow update: if (
          isAdmin() &&
          resource.data.status != 'Cancelled' &&
          (!('completed' in resource.data) || resource.data.completed != true)
        ) || (
          isOwner(userId) &&
          (!('confirmed' in request.resource.data) || request.resource.data.confirmed == resource.data.confirmed) &&
          (!('assignedStaffUid' in request.resource.data) || request.resource.data.assignedStaffUid == resource.data.assignedStaffUid) &&
          (!('staffName' in request.resource.data) || request.resource.data.staffName == resource.data.staffName) &&
          resource.data.status != 'Cancelled' &&
          (!('completed' in resource.data) || resource.data.completed != true)
        ) || (
          isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid &&
          resource.data.status != 'Cancelled'
        );
        
        allow delete: if isAdmin();
      }

      // Specific rule for notifications:
      // Admins need write access to create appointment update notifications for customers and staff
      match /notifications/{notificationId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Specific rule for reviews:
      // Customers can create reviews for their completed appointments or general service
      // Assigned staff can read published reviews assigned to them
      match /reviews/{reviewId} {
        allow read: if isOwner(userId) || isAdmin() || (isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid && resource.data.status == 'Published');

        allow create: if (
          isOwner(userId) &&
          request.resource.data.customerId == userId &&
          (
            !('appointmentId' in request.resource.data) ||
            request.resource.data.appointmentId == null ||
            (
              exists(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)) &&
              (
                (('completed' in get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data) &&
                 get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data.completed == true) ||
                (('status' in get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data) &&
                 get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data.status == 'Completed')
              ) &&
              (
                !('assignedStaffUid' in request.resource.data) ||
                request.resource.data.assignedStaffUid == null ||
                (('assignedStaffUid' in get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data) &&
                 request.resource.data.assignedStaffUid == get(/databases/$(database)/documents/users/$(userId)/appointments/$(request.resource.data.appointmentId)).data.assignedStaffUid)
              )
            )
          )
        ) || isAdmin();

        allow update: if (
          isOwner(userId) &&
          request.resource.data.customerId == resource.data.customerId &&
          (!('appointmentId' in resource.data) || resource.data.appointmentId == null || ('appointmentId' in request.resource.data && request.resource.data.appointmentId == resource.data.appointmentId)) &&
          (!('assignedStaffUid' in resource.data) || resource.data.assignedStaffUid == null || ('assignedStaffUid' in request.resource.data && request.resource.data.assignedStaffUid == resource.data.assignedStaffUid)) &&
          (!('staffName' in resource.data) || resource.data.staffName == null || ('staffName' in request.resource.data && request.resource.data.staffName == resource.data.staffName))
        ) || isAdmin();

        allow delete: if isOwner(userId) || isAdmin();
      }

      // Other subcollections (e.g. vehicles, paymentMethods, redeemedRewards)
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId) && subcollection != 'appointments' && subcollection != 'notifications' && subcollection != 'reviews';
      }
    }

    // 5. Collection group rule for appointments (used by admin and staff dashboards)
    match /{path=**}/appointments/{appointmentId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid) || 
                     (isAuthenticated() && resource.data.customerUid == request.auth.uid);
      allow write: if (isAdmin() && resource.data.status != 'Cancelled' && (!('completed' in resource.data) || resource.data.completed != true)) ||
                      (isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid && resource.data.status != 'Cancelled');
    }

    // 6. Collection group rule for reviews (used by admin, customer, and staff dashboards)
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && resource.data.customerId == request.auth.uid) || 
                     (isAuthenticated() && resource.data.assignedStaffUid == request.auth.uid && resource.data.status == 'Published');
      allow write: if isAdmin() || 
                      (isAuthenticated() && resource.data.customerId == request.auth.uid);
    }

    // 7. Rule for staff registration 
    match /pre_registered_staff/{document=**} {
      // Anyone can read this to verify their email during signup
      allow read: if true;
      // Nobody can write from the client app directly for security
      allow write: if false; 
    }

    // 8. Rule for settings
    match /settings/{document=**} {
      allow read: if true; // Allowed so staff can read access codes during signup
      allow write: if false;
    }

    // 9. Default fallback to lock down anything else not explicitly allowed above
    match /{document=**} {
      allow read, write: if false;
    }
    
  }
}
